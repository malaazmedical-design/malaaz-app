{
  "expo": {
    "name": "ملاذ",
    "slug": "malaaz",
    "owner": "malaaz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "malaaz",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C2B2A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.malaaz.homecare",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ملاذ يحتاج موقعك لتحديد أقرب مقدم خدمة في منطقتك",
        "NSLocationAlwaysUsageDescription": "ملاذ يحتاج موقعك لتحديد أقرب مقدم خدمة في منطقتك"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1C2B2A"
      },
      "package": "com.malaaz.homecare",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ملاذ يحتاج موقعك لتحديد أقرب مقدم خدمة"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C2B2A",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
